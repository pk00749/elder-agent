# 所有密钥从环境变量读，禁止硬编码（AGENTS.md §8）
# 复制为 .env 后填入真实值；.env 在 .gitignore 内

# ---- JWT (HS256, 密钥至少 32 字符；prod 走 KMS) ----
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=604800

# ---- 腾讯云 CloudBase（元数据）----
CLOUDBASE_ENV_ID=
CLOUDBASE_REGION=ap-shanghai

# ---- 腾讯云 COS（语音 / 临时上传）----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=elder-agent-dev
COS_UPLOAD_TTL_SECONDS=86400

# ---- DeepSeek Harness（agent-runtime；PRD §8.2）----
DSH_BASE_URL=http://mock-upstream:8080/dsh
DSH_API_KEY=

# ---- 千问 ASR / TTS（PRD §10.4，粤语男声）----
ASR_BASE_URL=http://mock-upstream:8080/asr
ASR_API_KEY=
TTS_BASE_URL=http://mock-upstream:8080/tts
TTS_API_KEY=
TTS_VOICE=zh_male_cantonese

# ---- 腾讯 TPush（PRD §11.18 双通道）----
TPUSH_BASE_URL=http://mock-upstream:8080/tpush
TPUSH_ACCESS_ID=
TPUSH_SECRET_KEY=
TPUSH_REMINDER_CHANNEL_ID=
TPUSH_APPOINTMENT_CHANNEL_ID=

# ---- 腾讯 SMS（验证码）----
SMS_BASE_URL=http://mock-upstream:8080/sms
SMS_APP_ID=
SMS_APP_KEY=
SMS_TEMPLATE_ID=
SMS_SIGN_NAME=

# ---- 服务端通用 ----
LOG_LEVEL=INFO
LOG_FORMAT=json
ENV=dev

# ---- 本地 mock infra 开关（CI / 本地 docker compose 起后 = enabled）----
MOCK_INFRA=
