# 行尾归一（CI 跨平台一致）
* text=auto eol=lf

# 显式声明 LF（避免 Windows 提交 CRLF）
*.py text eol=lf
*.kt text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.sh text eol=lf
*.ini text eol=lf
Dockerfile text eol=lf
*.xml text eol=lf

# 二进制（不允许 diff）
*.png binary
*.jpg binary
*.ico binary
*.webp binary
